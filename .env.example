# Ambiente de execução do Flask
FLASK_ENV=development

# Servidor local da aplicação
APP_HOST=127.0.0.1
APP_PORT=5000

# Nível de registro da aplicação (DEBUG, INFO, WARNING, ERROR)
APP_LOG_LEVEL=INFO

# API externa utilizada para consulta dos resultados das loterias
LOTTERY_API_BASE_URL=https://api.guidi.dev.br/loteria

# Tempos limite, em segundos, para conexão e leitura da API externa
API_CONNECT_TIMEOUT=3.05
API_READ_TIMEOUT=10

# Diretório opcional utilizado para armazenamento do cache
CACHE_DIR=
